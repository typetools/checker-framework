// Annotations for the Path Shape Checker.
// Most of its rules are implemented in PathShapeTreeAnnotator, because they cannot be expressed as
// annotations.

import org.checkerframework.checker.nullness.qual.PolyPathShape;

package java.io;

class File {
  // Not sound on Windows.  `new File("//server/share")` has a parent (`\\server`), but its
  // toPath() is a root.  The stub file sound-file-topath.astub makes toPath() return
  // @UnknownPathShape.
  @PolyPathShape java.nio.file.Path toPath(@PolyPathShape File this);
}

package java.nio.file;

interface Path {
  @PolyPathShape java.io.File toFile(@PolyPathShape Path this);
}
