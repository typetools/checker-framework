import static otherpkg.SamePackageSubclass.*;
import static publicpkg.PublicCharBufferSubclass.*;
import org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1;

// A static import on demand imports the member types that the named class inherits, but only the
// ones that are accessible where the import appears.  A package-private member type is accessible
// only in the package that declares it, so `import static otherpkg.SamePackageSubclass.*;` does not
// import `otherpkg.PackagePrivateMemberTypes.CharBuffer` into this compilation unit, which is in
// the unnamed package -- even though `SamePackageSubclass` does inherit that member type, because
// `SamePackageSubclass` is in the package that declares it.
//
// Inference must therefore resolve the name "CharBuffer" to
// `publicpkg.PublicCharBufferHolder.CharBuffer`, which the other static import on demand does
// import and which is relevant because it is a subtype of `CharSequence`, rather than to
// `otherpkg.PackagePrivateMemberTypes.CharBuffer`, which is irrelevant.  Neither member type has a
// canonical name that starts with the name of the class that its import names, so neither is found
// before the imports on demand are searched, and the import that names `SamePackageSubclass` is
// searched first.
//
// If inference resolves the name incorrectly and therefore discards the annotation, then the
// second (validation) pass of this test issues the warning that is written below.
@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.testchecker.ainfer.AinferRelevanceTestChecker")
public class OnDemandImportAccessibility {

    @org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1 CharBuffer charBufferField;

    @org.checkerframework.framework.qual.EnsuresQualifier(expression = { "this.charBufferField" }, qualifier = org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1.class)
    @org.checkerframework.dataflow.qual.Impure
    void assignField() {
        charBufferField = getSibling1CharBuffer();
    }

    @org.checkerframework.dataflow.qual.Impure
    void useField() {
        // :: warning: [argument]
        expectsSibling1CharBuffer(charBufferField);
    }

    @org.checkerframework.dataflow.qual.SideEffectFree
    void expectsSibling1CharBuffer(OnDemandImportAccessibility this, CharBuffer b) {
    }

    @org.checkerframework.dataflow.qual.Pure
    CharBuffer getSibling1CharBuffer(OnDemandImportAccessibility this) {
        return null;
    }
}
