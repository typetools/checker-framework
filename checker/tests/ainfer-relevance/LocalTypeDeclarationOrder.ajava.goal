// The scope of a local class declaration is the rest of the block that contains it, including the
// declaration itself.  A use of the same name that appears earlier in the block is not in that
// scope; it refers to some other type.  The name "Foo" in `UseBefore` refers to the member class
// `LocalTypeDeclarationOrder.Foo`, which is irrelevant because it is not a subtype of
// `CharSequence`, so inference must not write an annotation on it.  The name "Foo" in `UseAfter`
// refers to the local class, which `Elements` cannot look up by name, so inference conservatively
// writes the annotation.
@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.testchecker.ainfer.AinferRelevanceTestChecker")
public class LocalTypeDeclarationOrder {

    static class Foo {
    }

    @org.checkerframework.dataflow.qual.SideEffectFree
    static void declarationOrder() {
        class UseBefore {

            Foo field;

            @org.checkerframework.dataflow.qual.Impure
            void assignField() {
                field = new Foo();
            }
        }
        class Foo implements CharSequence {

            @org.checkerframework.dataflow.qual.Pure
            public  @org.checkerframework.checker.testchecker.ainfer.qual.AinferBottom int length(@org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType Foo this) {
                return 0;
            }

            @org.checkerframework.dataflow.qual.Pure
            public char charAt(@org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType Foo this,  @org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType int index) {
                return ' ';
            }

            @org.checkerframework.dataflow.qual.Pure
            public @org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType CharSequence subSequence(@org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType Foo this,  @org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType int start,  @org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType int end) {
                return this;
            }
        }
        class UseAfter {

            @org.checkerframework.checker.testchecker.ainfer.qual.AinferDefaultType Foo field;

            @org.checkerframework.dataflow.qual.Impure
            void assignField() {
                field = new Foo();
            }
        }
    }
}
