import org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1;

// A use of a type variable is relevant if the type variable's upper bound is relevant.  Inference
// must not discard an annotation that it infers for such a use.
@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.testchecker.ainfer.AinferRelevanceTestChecker")
public class RelevantTypeVariable<T extends CharSequence> {

    @org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1 T field;

    @org.checkerframework.dataflow.qual.Impure
    void assignField(T t) {
        // :: warning: [assignment]
        field = t;
    }

    @org.checkerframework.dataflow.qual.Impure
    void useField() {
        // :: warning: [argument]
        expectsSibling1(field);
    }

    @org.checkerframework.dataflow.qual.SideEffectFree
    static <U extends CharSequence> void expectsSibling1(U u) {
    }

    // Likewise when a use of the type variable is the element type of an array type.
    @org.checkerframework.checker.testchecker.ainfer.qual.AinferSibling1 T[] arrayField;

    @org.checkerframework.dataflow.qual.Impure
    void assignArrayField(T[] t) {
        // :: warning: [assignment]
        arrayField = t;
    }

    @org.checkerframework.dataflow.qual.Impure
    void useArrayField() {
        // :: warning: [argument]
        expectsSibling1(arrayField[0]);
    }
}
